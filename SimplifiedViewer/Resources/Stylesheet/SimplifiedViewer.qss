/* Set the background color */
QWidget {
    background-color: #323232;
    font-size: 28px;
}

/* Set the font and text color for QLabel */
QLabel {
    color: #FFFFFF;
}

/* Set the background color and text color for QPushButton */
QAbstractButton {
    background-color: #6B0002;
    color: #FFFFFF;
    padding: 20px 20px;
    border-radius: 0px;
}

/* Set the hover and pressed state for QPushButton */
QAbstractButton:hover {
    background-color: #870000;
}

QAbstractButton:pressed {
    background-color: #4F0001;
}
