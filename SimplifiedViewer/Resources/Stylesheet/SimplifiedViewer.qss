/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the background color */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QWidget
{
    background-color: palette(Base);
    font-size: 28px;
}

/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the font and text color for QLabel */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QLabel
{
    color: palette(Text);
}

/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the background color and text color for QPushButton */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QAbstractButton
{
    background-color: palette(Button);
    color: palette(Light);
    padding: 20px 20px;
    border-radius: 0px;
}

QAbstractButton:focus {
    border: none;
    outline: none;
}

QAbstractButton:disabled
{
    background-color: palette(Dark);
}

QAbstractButton:checked
{
    background-color: palette(Mid);
}

QAbstractButton:hover
{
    background-color: palette(MidLight);
}

QAbstractButton:pressed
{
    background-color: palette(Dark);
}

/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the background color and text color for QCheckBox */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QCheckBox
{
    background-color: None;
}
QCheckBox::checked
{
    background-color: None;
}
QCheckBox:hover
{
    background-color: None;
}

QCheckBox::indicator::checked
{
    background-color: palette(MidLight);
    border: 1px solid palette(Mid)
}
QCheckBox::indicator::unchecked
{
    background-color: palette(Dark);
    border: 1px solid palette(Mid)
}

/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the background color and text color for QSlider */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QSlider
{
    height: 30px;
    width: 30px;
    margin-left: 10px;
    margin-right: 10px;
    selection-background-color: palette(Light);
    background: None
}

QSlider:handle
{
    background: palette(Button);
    border: 1px solid palette(Base);
}

QSlider:handle:hover
{
    background: palette(MidLight);
}

QSlider:handle:pressed
{
    background: palette(Dark);
}

QSlider:handle:horizontal
{
    width: 10px;
    height: 20px;
    margin: -10px 10px;
}

QSlider:handle:disabled
{
    background-color: palette(Dark);
}

QSlider:groove:horizontal
{
    margin: 3px;
    height: 3px;
    border: 3px solid;
}

QSlider:add-page:horizontal
{
    background: palette(Dark);
}

QSlider:sub-page:horizontal
{
    background: palette(Mid);
}

QSlider:groove:disabled
{
    background-color: palette(Dark);
}

QSlider:add-page:horizontal:disabled
{
    background: palette(Dark);
}

QSlider:sub-page:horizontal:disabled
{
    background: palette(Dark);
}

/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
/* Set the customization for QTabWidget */
/* !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! */
QTabBar::tab
{
  background-color: palette(Button);
  padding: 8px 8px;
} 

QTabBar::tab:selected
{
  background-color: palette(Dark);
}

QTabBar::tab:hover
{
    background-color: palette(MidLight);
}
